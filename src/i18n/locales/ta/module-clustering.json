{
  "s_0914231b": "விடுபட்ட மதிப்புகள்",
  "s_0a6b8020": "வேகம்",
  "s_0ac8a560": "மீட்டமை",
  "s_0fb50a2c": "● செயலில்",
  "s_0ff98bf8": "கர்னல்",
  "s_1215d4a9": "இறக்குமதி CSV",
  "s_1240f1f8": "சராசரி ஷிப்ட்",
  "s_12424e6c": "அளவு · சராசரி தூரம் · விட்டம்",
  "s_12df35ae": "ஏற்றுமதி கிளஸ்டர்கள்",
  "s_1310aae8": "பட உட்பொதிப்புகள்",
  "s_150c49ee": "கே (கிளஸ்டர்களின் எண்ணிக்கை)",
  "s_152e2c57": "காஸியன் கலவை மாதிரி",
  "s_152f3539": "Δ பதிவு சாத்தியம்",
  "s_1585c06e": "படத் தரவு",
  "s_160d742b": "· மொத்த புள்ளிகள்",
  "s_161bf7f6": "லாப்லாசியன்",
  "s_167828f7": "தானியங்கி அதிகபட்ச தூரம்",
  "s_16ffff7a": "இழுத்து விடு CSV",
  "s_170da3d4": "பாடம் பாதை",
  "s_1710d0f1": "பார்வையை மீட்டமைக்கவும்",
  "s_178ee7ba": "கொத்துகள்",
  "s_17f79b44": "மொத்த புள்ளிகள்",
  "s_1908f2d6": "பாடங்கள்",
  "s_19ce901a": "இந்தப் பக்கம் டைப்ஸ்கிரிப்டில் உருவாக்கப்பட்ட புள்ளிகளிலிருந்து பணிகள் மற்றும் அளவீடுகளைக் கணக்கிடுகிறது; பின்தளம் அல்லது ஒதுக்கிட மதிப்புகள் பயன்படுத்தப்படவில்லை.",
  "s_1aa8e94c": "படி முன்னோக்கி →",
  "s_1ae6266e": "அம்சம் பொறியியல்",
  "s_1b974172": "எப்சிலன் (ε) - அடையக்கூடிய வரம்பு ⓘ",
  "s_1bd8ea3c": "◉ குவிந்த மையம்",
  "s_1c1b7097": "உள்ளூர் விலங்குகள் தரவுத்தொகுப்பை ஏற்றவும்",
  "s_1c2f1dee": "⟳ மாறவும்",
  "s_1d10ba12": "EM வரலாறு (உண்மையில் பொருத்தப்பட்ட நிலைகள்)",
  "s_1d6f623d": "OPTICS பிரிவுகள்",
  "s_1efe490b": "☼ படி",
  "s_1f0ae2ae": "தரப்படுத்து (z-ஸ்கோர்)",
  "s_1f2ecf71": "சத்தம்",
  "s_1f49f74e": "கிளஸ்டர் பணி",
  "s_1fc76fde": "செலவு பாதிப்பு (வெளியேற்றங்கள் அகற்றப்பட்டன)",
  "s_1fdcc0bd": "⌄ ஸ்டைலிங்",
  "s_21a3af0c": "மாணவர்கள்: படிப்பு நேரம் மற்றும் மதிப்பெண்",
  "s_21d50829": "· ஒன்றிணைந்தது",
  "s_2280da83": "━ ஆர்டர் செய்யும் பாதை",
  "s_22c536f3": "GMM சகிப்புத்தன்மை",
  "s_231fd566": "அடுத்து ›",
  "s_232109ce": "DBSCAN பிரிவுகள்",
  "s_256dc555": "லேபிள்கள் ஏற்றுமதி செய்யப்பட்டன",
  "s_25b1c670": "கிளஸ்டர் வெளியீடு (ஒன்றுபட்டது)",
  "s_25f43896": "மெனு மாற்றப்பட்டது",
  "s_26b6b194": "⌄ மாதிரி தரவுத்தொகுப்புகள்",
  "s_28528e11": "அளவுகோல்",
  "s_2880368b": "புள்ளி தரவு",
  "s_28a379cb": "அம்சங்கள் ·",
  "s_28af3f7d": "சிறிய அலைவரிசை → மேலும் விவரம் (அதிக கிளஸ்டர்கள்)",
  "s_290081d4": "அதிகபட்ச மறு செய்கைகள் எண்",
  "s_2933c516": "படிநிலை கிளஸ்டரிங் பிரிவுகள்",
  "s_2966369a": "புதிய செலவு",
  "s_29cbeb4f": "◉ மெகா எம்.எல்",
  "s_2a01c700": "மெகா எம்.எல்",
  "s_2a229c78": "நோக்கத்திற்காக நிறமற்றது - இந்த வரைபடத்திற்குப் பிறகு கிளஸ்டரிங் நிகழ்கிறது.",
  "s_2a670d28": "அக்கம் பக்கத்தினர்",
  "s_2ad28780": "கூறு",
  "s_2b037492": "ஒன்றிணைக்கிறது:",
  "s_2bd57c69": "கொத்துக்களை உருவாக்க வெட்டப்பட்ட உயரக் கோட்டை இழுக்கவும்.",
  "s_2c766d55": "பைனரி kNN",
  "s_2c8996b2": "முன்நிபந்தனைகளைத் திறக்கவும்",
  "s_2d3f7c53": "OPTICS தரவுத்தொகுப்பு",
  "s_3033008f": "மேற்பார்வையிடப்பட்ட கற்றல்",
  "s_3124fb0d": "உதவி & ஆதாரங்கள்",
  "s_32406d2c": "கணித விவரங்களைக் காண்க →",
  "s_335528d1": "படிக்கும் நேரம்:",
  "s_3393af20": "அல்காரிதம் நிலை",
  "s_33a514f6": "பட கிளஸ்டர் கேலரி",
  "s_34167278": "கிளஸ்டர்களின் எண்ணிக்கை (k)",
  "s_3508f829": "கோப்பிற்கு குறைந்தபட்சம் K எண் வரிசைகள் தேவை",
  "s_35582c36": "காசியன்",
  "s_363a7c58": "குறிப்புகளைப் பதிவிறக்கவும்",
  "s_371ebe8c": "பாடம் முன்னேற்றம்",
  "s_373341a8": "தூரம்:",
  "s_37bc940c": "செபிஷேவ்",
  "s_37ded562": "தூர மெட்ரிக்",
  "s_38b3559f": "தர அளவீடுகள்",
  "s_38b8feee": "என்ன நடக்கிறது?",
  "s_38faab5a": "எப்சிலன் எண்",
  "s_39101d0c": "பதிவேற்றம் CSV",
  "s_3a32f6bc": "பகிர்வு இணைப்பு நகலெடுக்கப்பட்டது",
  "s_3a4f6c28": "படங்களை அழி",
  "s_3a64aa87": "இடர்",
  "s_3a972b9a": "சமச்சீர்",
  "s_3aea3a91": "✓ இப்போது புதுப்பிக்கப்பட்டது",
  "s_3b8cad6c": "தளவமைப்பு (வரைபடம்)",
  "s_3ba071ac": "கூறு ஸ்வீப் (அதே தரவு; BIC/AIC சிக்கலைத் தண்டிக்கும்)",
  "s_3bdf3a36": "ஒருங்கிணைக்கும் மெர்ஜ் மரம்",
  "s_3bebfacb": "ரயில் K- அர்த்தம்",
  "s_3c0c37af": "காட்சிப்படுத்தல்",
  "s_3c0d9ed9": "தரவுத்தொகுப்பை மாற்றவும்",
  "s_3d10ceef": "K-Medoids ஏன் திறக்கப்பட்டது",
  "s_3d5d32dc": "● கிளஸ்டர்",
  "s_3ddfc9a9": "எம்.கே",
  "s_3e8d9391": "அடையக்கூடிய தூரம்",
  "s_3edb79cf": "♙ குறிக்கோள்",
  "s_3f47677d": "பிரித்தெடுக்கும் கொத்துக்கள்",
  "s_3f4ab91d": "கடினமான பணி",
  "s_3fdfcccf": "எம்.எம்",
  "s_40ffb6fc": "EM மறு செய்கை",
  "s_4115d182": "சீரற்ற",
  "s_4190308e": "கே - மெடாய்ட்ஸ்",
  "s_42107a05": "தற்போதைய மைய புள்ளியில் இருந்து, அனைத்து அடர்த்தி-அடையக்கூடிய மைய புள்ளிகளும் கிளஸ்டரில் சேர்க்கப்படுகின்றன. விரிவாக்கம் தொடர்கிறது.",
  "s_42197aab": "மூல ஆயத்தொகுப்புகள் (இசட்-ஸ்கோர் இல்லை)",
  "s_42da0bd8": "குறிக்கோள்",
  "s_43021381": "மெட்ரிக்:",
  "s_434cfcb8": "இயல்பாக்கப்பட்டது",
  "s_439af708": "பிரித்தெடுத்தல் DBSCAN* கிளஸ்டர்கள்",
  "s_444f69b1": "கிளஸ்டர் சுருக்கம்",
  "s_44aed3c4": "சராசரி ஷிப்ட் பிரிவுகள்",
  "s_46a6d99f": "சீரற்ற விதை",
  "s_46b767f3": "காட்சி சேமிக்கப்பட்டது",
  "s_46e1142f": "அம்சம் 2",
  "s_470e77f5": "அல்லது உலாவ கிளிக் செய்யவும்",
  "s_47693a36": "குறைந்தபட்ச புள்ளிகள்",
  "s_47c7e519": "கலவை கூறுகள்; GMM திட்டமிடப்பட்ட 2D ஆயங்களைப் பயன்படுத்துகிறது",
  "s_47e115c2": "அம்சம் 1",
  "s_47f1f7b7": "OPTICS",
  "s_48003155": "தரவுத்தொகுப்பைக் காண்க ↗",
  "s_48078dc8": "சராசரி",
  "s_4844e1c1": "ⓘ வண்ணத் தீவிரம், அருகிலுள்ள கூறுகளுக்கு ஒவ்வொரு புள்ளியின் மென்மையான உறுப்பினர் (பொறுப்பு) காட்டுகிறது.",
  "s_486d778e": "குவிதல்",
  "s_4a199aa7": "மதிப்பிடப்பட்ட மதிப்பெண்:",
  "s_4a223096": "எப்போது நிறுத்து |ΔLL| ≤ சகிப்புத்தன்மை·n, அல்லது அதிகபட்ச மறு செய்கைகள். மூலைவிட்ட முறைப்படுத்தலுடன் கோவேரியன்ஸ் முழு 2×2 ஆக உள்ளது (டயக்/டைட்/கோளமானது செயல்படுத்தப்படவில்லை).",
  "s_4b2cfbcc": "புறம்போக்கு",
  "s_4b42e817": "மூடு படி வழிகாட்டி",
  "s_4b5ea35e": "அடையக்கூடிய வரிசைப்படுத்தல்",
  "s_4bcdff01": "விரைவான உதவிக்குறிப்பு",
  "s_4c3ed05a": "சீரற்ற சென்ட்ராய்டு துவக்கம்",
  "s_4cbdde63": "medoids மற்றும் non-medoid புள்ளிகளுக்கு இடையே உள்ள இடமாற்றங்களை மதிப்பிடவும். மொத்த செலவைக் குறைக்கும் ஸ்வாப்பை வைத்திருங்கள்.",
  "s_4de60c63": "அதிகபட்ச மறு செய்கைகள்:",
  "s_4def410e": "இன்ஸ்பெக்டர்",
  "s_4e572a9f": "ஒற்றை மற்றும் முழுமையான இணைப்புடன் பிரிட்ஜ் தரவுத்தொகுப்பை முயற்சிக்கவும், பின்னர் அதே வெட்டு உயரத்தில் கிளஸ்டர் எண்ணிக்கையை ஒப்பிடவும்.",
  "s_4e8f0629": "‹ முந்தைய",
  "s_4ea3ba39": "அதிக minPts → கடுமையான மைய வரையறை",
  "s_4ed33297": ", அண்டை நாடுகள் அதிகபட்சம்-ε",
  "s_4ee1fc54": "அடுத்து: இணைப்பு முறைகளை ஒப்பிடுக",
  "s_4ef97f51": "காலப்போக்கில் ஒன்றிணைதல்",
  "s_50e0d790": "அளவுருக்களை புதுப்பிக்கவும்",
  "s_51f9c4c3": "நிறைவுக்கு ஓடுங்கள்",
  "s_523bf242": "புள்ளி அளவு",
  "s_52fa9f9a": "▣ அனிமேட் மெர்ஜஸ்",
  "s_5365be19": "வழக்குகளைப் பயன்படுத்தவும்",
  "s_542ef7fb": "வார்டு (குறைந்தபட்ச மாறுபாடு)",
  "s_542fed8a": "கோப்புறைகள்",
  "s_54764a76": "புள்ளிகள்",
  "s_54860850": "அலைவரிசை (h) - அடர்த்தி முறைகளுக்கான சுற்றுப்புற ஆரம்",
  "s_5575d9f6": "← தொகுதிகளுக்குத் திரும்பு",
  "s_55aa6817": "மந்தநிலை/SSE",
  "s_562f61fe": "சில்ஹவுட், அருகிலுள்ள மற்ற கிளஸ்டருடன் கிளஸ்டர் தூரத்தை ஒப்பிடுகிறது. அதன் உச்சம் முழங்கையுடன் உடன்படாமல் இருக்கலாம், இது பயனுள்ள பாடம்.",
  "s_5637e24f": "தனிப்பயன் பதிவேற்றவும்",
  "s_566f5326": "அடர்த்தி நிலப்பரப்பு",
  "s_57d28e3f": "எதுவும் இல்லை (மூல ஒருங்கிணைப்புகள்)",
  "s_57e96905": ", மைய தூரம்",
  "s_57f0f3f5": "வெட்டு உயர எண்",
  "s_58ca9f2e": "மால் வாடிக்கையாளர்கள் உண்மையான அட்டவணை",
  "s_593ef94d": "பதிவுகள்",
  "s_5a4cdc05": "படிப்பு நேரம் சரிபார்ப்பு",
  "s_5bf201f2": "தீம் மாற்றப்பட்டது",
  "s_5c178b88": "அயலவர்கள்",
  "s_5c6c0389": "கூறுகள்",
  "s_5da036d3": "ஆர்டர் செய்யும் பாதையைக் காட்டு",
  "s_5de843d7": "வெட்டப்பட்ட கொத்துகள்:",
  "s_5e712776": "ⓘ உதவிக்குறிப்பு: சராசரி ஷிப்ட், க்ளஸ்டர் எண்ணிக்கையைக் குறிப்பிடாமல் அடர்த்தி உச்சங்களைக் கண்டறிகிறது. வெவ்வேறு கிரானுலாரிட்டிகளை ஆராய அலைவரிசையை சரிசெய்ய முயற்சிக்கவும்.",
  "s_5e7af3e3": "அல்காரிதம் மூலம் படி",
  "s_5ee7339b": "படித்தல்",
  "s_5f73ea29": "மறு செய்கை மூலம் மந்தநிலை",
  "s_5fd77ceb": "MinPts எண்",
  "s_5fe75432": "புள்ளியைச் சேர்க்கவும்",
  "s_6051ee37": "சதி காட்சி",
  "s_609271c4": "அடுக்கு அளவு",
  "s_62066897": "எல்லை:",
  "s_628ea1a2": "நிறைவு",
  "s_62d7de84": "செயல்கள்",
  "s_63fb1738": "அலைவரிசை/வாசல்:",
  "s_64303afb": "டேட்டாசெட்:",
  "s_64e245a5": "எல்.எல்",
  "s_662e1bca": "அனுமானம்:",
  "s_6669aab9": "கே-என்றால் கட்டுப்பாடுகள்",
  "s_66e71fd1": "வரையறுக்கப்படாத அணுகல் என்பது வரையறுக்கப்பட்ட தொப்பியில் திட்டமிடப்பட்டுள்ளது, 0 ஆக இல்லை.",
  "s_d0c27b03": "தரவுத்தொகுப்பு",
  "s_dce2da08": "அடுத்து"
}
