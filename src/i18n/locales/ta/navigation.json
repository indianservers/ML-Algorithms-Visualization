{
  "s_045cee61": "உள்ளூர் மினிமா & சேடில் புள்ளிகள்",
  "s_067820e5": "மேட்ரிக்ஸ் காரணியாக்கம்",
  "s_0736dd56": "திணிப்பு",
  "s_07903f93": "ஹோல்ட்-குளிர்காலம்",
  "s_08c14359": "கவனம்",
  "s_0914231b": "விடுபட்ட மதிப்புகள்",
  "s_0a54e38c": "உலாவி அனுமானம்",
  "s_0e3625ae": "நியூரான் & பெர்செப்ட்ரான்",
  "s_0efb196c": "வார்த்தை உட்பொதித்தல்",
  "s_1240f1f8": "சராசரி ஷிப்ட்",
  "s_13c52795": "அல்காரிதம் ஆய்வகம்",
  "s_13f02ba0": "ஹோலிஸ்டிக் பாடி டிராக்கர்",
  "s_14c3c48e": "தரவுத்தொகுப்பு நுண்ணறிவு",
  "s_14dabb65": "உங்கள் மாதிரியைப் பயிற்றுவிக்கவும்",
  "s_152e2c57": "காஸியன் கலவை மாதிரி",
  "s_174a12ce": "அடாபூஸ்ட்",
  "s_1a481506": "உரை வகைப்பாடு",
  "s_1bab5296": "சாய்வு அதிகரிக்கும் வகைப்பாடு",
  "s_1cf8b937": "சார்பு-மாறுபாடு வர்த்தகம்",
  "s_1d21914a": "எஸ்.வி.ஆர்",
  "s_1da1c903": "போஸ் ஆங்கிள் அனலைசர்",
  "s_23c85bd0": "கணினி பார்வை",
  "s_2535db63": "மாதிரி ஒப்பீட்டு டாஷ்போர்டு",
  "s_270cb83a": "கற்றல்-விகித அட்டவணைகள்",
  "s_285691ac": "லாஜிஸ்டிக் பின்னடைவு",
  "s_2a09faff": "முன்னோக்கி பாஸ்",
  "s_2c7f9431": "குறுக்கு சரிபார்ப்பு",
  "s_3037b0cb": "மறைந்து & வெடிக்கும் சாய்வுகள்",
  "s_3079cfef": "வேகம்",
  "s_3167b4d7": "பரிமாணக் குறைப்பு",
  "s_3624d499": "நேரத் தொடர்",
  "s_362ffcb6": "விஷன் பைப்லைன் பில்டர்",
  "s_382a30d3": "விளக்கமளிக்கும் மையம்",
  "s_383bde99": "முகம் கண்ணி",
  "s_39cade3d": "உடற்பயிற்சி / பிரதிநிதி கவுண்டர்",
  "s_3a355bd2": "டோக்கன்",
  "s_3aae2ab5": "பல தலை கவனம்",
  "s_3bca3ff7": "TF-IDF",
  "s_3d47a133": "பல நேரியல் பின்னடைவு",
  "s_3ee68757": "பரிசோதனை பணியிடம்",
  "s_3f974f12": "மாதிரி உயிரியல் பூங்கா",
  "s_41abf6ff": "தரவு கசிவு",
  "s_433094a4": "அறிக்கை உருவாக்குபவர்",
  "s_43829a93": "சாய்வு அதிகரிக்கும் பின்னடைவு",
  "s_476dde68": "நகரும் சராசரி",
  "s_47f1f7b7": "OPTICS",
  "s_4affe74d": "கட்டிடக்கலை ஓட்டம் ஆய்வகம்",
  "s_52f50eae": "முகப்பு",
  "s_5d233e9c": "சேமிக்கப்பட்ட சோதனைகள்",
  "s_5f945f85": "பின்னடைவு அளவீடுகள்",
  "s_664d3b04": "எம்.எல்.பி"
}
