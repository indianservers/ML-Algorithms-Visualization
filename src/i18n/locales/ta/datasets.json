{
  "s_05bdc074": "சராசரி",
  "s_070a235d": "பாக்ஸ் ப்ளாட்:",
  "s_07392912": "விளம்பரங்கள், சரக்கு இடைவெளி மற்றும் பருவகால தேவை ஆகியவற்றுடன் வாராந்திர ஆர்டர்களை விரிவுபடுத்தியது.",
  "s_07878fe6": "தரவுத்தொகுப்புகளைத் தேடுங்கள்",
  "s_07c27e80": "நேரியல் முறையில் பிரிக்கக்கூடிய குமிழ்கள்",
  "s_0811b84d": "திருத்தக்கூடிய தரவு கட்டம்",
  "s_082edfc6": "சராசரி குற்றச்சாட்டு (எண்)",
  "s_08335381": "↻　மீட்டமை",
  "s_08adf3f4": "↕ தரவுத்தொகுப்பை மாற்றவும்",
  "s_0914231b": "விடுபட்ட மதிப்புகள்",
  "s_0a032416": "ஹீட்மேப் ஃபோகஸ் செய்யப்படவில்லை",
  "s_0a13319b": "2 அம்சங்கள் (MedInc, AveRooms)",
  "s_0ab2830f": "மிகப்பெரிய வகுப்பு உள்ளது",
  "s_0ac8a560": "மீட்டமை",
  "s_0b64cf02": "இலக்கு நெடுவரிசை",
  "s_0bfad8a8": "மறைமுகமான மற்றும் வெளிப்படையான ஷாப்பிங் சிக்னல்கள்: கிளிக்குகள், கார்ட் சேர்க்கைகள், கொள்முதல் மற்றும் விருப்ப மதிப்பீடுகள்.",
  "s_0cc1bb9c": "பிடிப்பு",
  "s_0dbe382b": "அளவிடுதல் முறை",
  "s_0dc48142": "நகரம்",
  "s_0e3f17be": "செண்டிமெண்ட் சோதனைகளுக்கு துருவமுனைப்பு புரட்டுகிறது.",
  "s_0e8c79df": "நான் - நிறுத்தற்குறி மற்றும் வழக்கு",
  "s_0ec5ae1b": "செயல்படுத்தல் கவரேஜ்",
  "s_0edf33c9": "புதிய நெடுவரிசை",
  "s_0f2e916f": "சுத்தமான சராசரி கணக்கிடப்பட்ட தரவுத்தொகுப்பு ஏற்றுமதி செய்யப்பட்டது",
  "s_0f32bddd": "பருவகால உச்சநிலைகள் மற்றும் மெதுவான வருடாந்திர போக்கு ஆகியவற்றுடன் மாதாந்திர விற்பனை விரிவாக்கப்பட்டது.",
  "s_0f587261": "அவுட்லியர் என்பது விசாரணைக்கான சமிக்ஞையாகும், தானாகவே மோசமான வரிசை அல்ல.",
  "s_0f5e4465": "அட்டவணைக்கு முன் / பின்",
  "s_0fabc2c6": "பணி வடிகட்டி",
  "s_0fc29c64": "3. கார்டினாலிட்டி & கசிவு சோதனை　ⓘ",
  "s_0ff87f71": "மீட்டமை",
  "s_100276f3": "IBM: பணியாளர் அட்ரிஷன்",
  "s_101783d4": "IQR மற்றும் z-ஸ்கோர் வேலிகள் கொடியாக இருக்க வேண்டும்.",
  "s_10c29643": "வகுப்பு இருப்பு",
  "s_117d43cf": "செய்தி தலைப்பு உரை தரவுத்தொகுப்பு (760 வரிசைகள்)",
  "s_11d8c451": ", கடுமையான",
  "s_11f6d87b": "டாஷ்போர்டு",
  "s_12285150": "தரவுத்தொகுப்புகள்",
  "s_12305e08": "இரண்டு பருவகால சுழற்சிகள்",
  "s_124333d8": "புதியதைச் சோதிக்கவும்",
  "s_1274fec4": "UCI: வங்கி சந்தைப்படுத்தல்",
  "s_12931341": "உதாரணம்",
  "s_129f981c": "இயந்திர சுமை சென்சார் வரிசை (760 வரிசைகள்)",
  "s_12b349f1": "முக்கிய நுண்ணறிவுகள்　ⓘ",
  "s_12ffd665": "பரப்பளவு, படுக்கையறைகள், குளியலறைகள், வயது, மையத்திற்கான தூரம் மற்றும் விலையுடன் கூடிய விரிவாக்கப்பட்ட வீடுகள்.",
  "s_13391683": "செயற்கை பட கட்டம்",
  "s_133e8f6c": "ஆன்லைன் பாட மதிப்பீடுகள் (760 வரிசைகள்)",
  "s_1364ca64": "நேரத் தொடர் சுயவிவரம்",
  "s_137753f4": "தரவுத்தொகுப்பைப் பதிவேற்றவும்",
  "s_139e96fa": "#''அம்சம்''''''''''''''முக்கியத்துவம்",
  "s_13d25cf8": "பாவம்",
  "s_13ebad9e": "சிதறல் வடிவியல் கவனம்",
  "s_1467850a": "தரவுத்தொகுப்பு கோப்பை பதிவேற்றவும்",
  "s_14b05fac": "வெளிநாட்டவர்கள்",
  "s_14c545a2": "இத்தாலிய, இந்திய, மெக்சிகன், ஜப்பானிய மற்றும் அமெரிக்க உணவகங்களுக்கான உணவக மதிப்பீடுகள்.",
  "s_150d9e6e": "தரவுத்தொகுப்பை உருவாக்கவும்",
  "s_15304848": "· போதுமான அளவு:",
  "s_15d27dfe": "தரவுத்தொகுப்பு மேலோட்டம்",
  "s_1633b7f3": "கசிவைத் தடுக்க, மடிப்புக்கு வெளியே உள்ள தரவைப் பயன்படுத்தி இலக்குப் புள்ளிவிவரங்கள் கணக்கிடப்படுகின்றன.",
  "s_163e1d27": "வெளிப்புற தாக்கம்",
  "s_165903ec": "மூலோபாய வழிகாட்டி",
  "s_1674bcc8": "புதிய திட்ட தரவுத்தொகுப்பு",
  "s_16cc5e97": "தீர்மானிக்கும் வீட்டு அட்டவணை: பகுதி, படுக்கையறைகள், வயது, தூரம் → விலை.",
  "s_16dbdbe5": "④ மதிப்பிடவும்",
  "s_17897598": "வாசல்",
  "s_186826cd": "சேமித்த தரவுத்தொகுப்புகள், குறிச்சொற்கள், நெடுவரிசைகளைத் தேடுங்கள்",
  "s_189684b5": "◉　நிலை 12",
  "s_18ae6c91": "புள்ளி",
  "s_191a6e02": "அதிர்வெண் குறியாக்கம்",
  "s_19972396": "நல்லது!!! vs நல்லது vs நல்லது?",
  "s_1a6bd4e2": "வெற்றுப் பகுதி, வயது மற்றும் தொலைதூரக் கலங்களைக் கொண்ட முகப்புப் பட்டியல்கள், விடுபட்ட மதிப்புக் கருவிகள் சரிசெய்வதற்கு உண்மையான இடைவெளிகளைக் கொண்டுள்ளன.",
  "s_1a7756f3": "தனிப்பயன் மதிப்பு",
  "s_1a7d548a": "✓ காரணங்களை புரிந்து கொள்ள வெளியில் உள்ளவர்களை பரிசோதிக்கவும்",
  "s_1aaf9e8c": "செயற்கை கட்டம் உலகம்",
  "s_1ae6266e": "அம்சம் பொறியியல்",
  "s_1b165220": "வெளிப்புற கண்டறிதல் பிரிவுகள்",
  "s_1b41e96d": "என்ன முயற்சி செய்ய வேண்டும்",
  "s_1b525fc8": "Z வாசல்:",
  "s_1b62449a": "கிளாசிக் நேரியல் அல்லாத 3D பன்மடங்கு.",
  "s_1b9ff923": "அம்சம் சேர்க்கப்பட்டது",
  "s_1bbc9a9f": "IQR வேலிகள்",
  "s_1bf23562": "பெருக்கி (k)",
  "s_1c2bea87": "விடுபட்ட வடிவங்கள் தோன்றும்",
  "s_1c3b337f": "பரிந்துரைக்கப்பட்ட திட்டம்",
  "s_1c9e9896": "காலம் 7 மற்றும் காலம் 28 கலந்தது",
  "s_1cc479dc": "செட்டோசா",
  "s_1ccacb92": "Transform　→ க்குச் செல்லவும்",
  "s_1cde4407": "IQR",
  "s_1cfc952a": "① அறிக　━━　② காட்சிப்படுத்து　━━　③ உருமாற்றம்,",
  "s_1d175fae": "% மற்றும் நிலையான விலகல் மூலம்",
  "s_1de1cd40": "நுண்ணறிவு அறிக்கையை ஏற்றுமதி செய்யவும்",
  "s_1e274539": "என்கோடிங் கட்டுப்பாடுகள் மீட்டமைக்கப்பட்டது",
  "s_1e8e2ac0": "முந்தைய செயலாக்க தரவுத்தொகுப்புக்கு முன் சுத்தம் செய்யப்பட்ட வரைவு மீட்டமைக்கப்பட்டது.",
  "s_1f1bd1ce": "கூட்டு வடிகட்டலுக்கான செல்கள் விடுபட்ட ஐந்து புத்தக வகைகளில் வாசகர் மதிப்பெண்கள்.",
  "s_1f50e5f4": "தற்போதைய தாக்கம்",
  "s_1f6ac9a6": "செயல்திறன் மற்றும் தேர்ந்தெடுக்கப்பட்ட அம்சங்களின் எண்ணிக்கை",
  "s_1fe06bf6": "போஸ் முக்கிய அம்சங்கள்",
  "s_1ff01995": "↗ தரவுத்தொகுப்பை ஆராயுங்கள்",
  "s_1ffa062a": "y_t ≈ 0.8 y_{t-1} + சத்தம்",
  "s_20028d26": "முக்கிய கவனிப்பு",
  "s_20431b75": "கற்றுக்கொள்ளுங்கள்",
  "s_205cb2e4": "அசல் மாதிரி",
  "s_209a72ba": "விளையாட்டு",
  "s_20afd5de": "நான்கு குறுக்காக எதிர் மேகங்கள். ஒரு நேரியல் உணர்திறன் தோல்வியடைகிறது; ஒரு MLP அல்லது கர்னல் முறை அவற்றைப் பிரிக்கலாம்.",
  "s_2147abab": "தரவு ஆதாரங்கள்",
  "s_21543b5b": "＋ அம்சத்தைச் சேர்க்கவும்",
  "s_2199089a": "KNN / k- அர்த்தம் (தொலைவு உணர்திறன்)",
  "s_21ce38b5": "அம்சம் தொடர்பு",
  "s_2203b5da": "பிறகு மீட்டமைக்கவும்",
  "s_224df093": "என்கோடிங் தாக்கம் (CV AUC)",
  "s_224ffcd6": "சி - உயர் பரிமாண குமிழ்கள்",
  "s_22a4deb2": "மோசடி கண்டறிதல்",
  "s_22c12a47": "நெடுவரிசை",
  "s_2364920f": "வேறுபாட்டிற்கான இருபடி சறுக்கல்",
  "s_23ddb138": "தரவுத்தொகுப்பு பக்கத்திற்குச் செல்லவும்",
  "s_23ee33a9": "◉　அவுட்லையர்களை பரிசோதிக்கவும்",
  "s_23f06ca7": "தரவு விஞ்ஞானி",
  "s_2484bc42": "B — 3D விமானம் போன்றது",
  "s_24d4d335": "சாதாரண வரிசைகள் இல்லை; வாசலை அதிகரிக்க",
  "s_24eeacd8": "கேபி",
  "s_2502d05d": "கையொப்பமிடப்பட்ட தொடர்பு",
  "s_2555e3fc": "PCA சீரமைப்புச் சரிபார்ப்புகளுக்கான இரண்டு மிகவும் தொடர்புள்ள எண் அம்சங்கள்.",
  "s_255b5160": "சரிபார்ப்பு செயல்திறன்　ⓘ",
  "s_25a2cf5e": "முன்பு",
  "s_25a7e35c": "பட்டை",
  "s_25d79e78": "ROC AUC",
  "s_25e35688": "உதாரணம் மூலம் கற்றுக்கொள்ளுங்கள்　ⓘ",
  "s_26017e08": "ஸ்பேம்",
  "s_264299ce": "மாதிரி வகை",
  "s_27265059": "தோள்பட்டை, இடுப்பு மற்றும் முழங்கால் கோணங்கள் போஸ் வகைப்பாட்டிற்காக நிற்க, உட்கார, குந்து, மற்றும் அலை என்று பெயரிடப்பட்டுள்ளன.",
  "s_2732e70e": "நான் - சத்தம் உயர் பரிமாணம்",
  "s_278b16d8": "வரிசைகள்",
  "s_27d7d97d": "பாடம் மெனு திறக்கப்பட்டது",
  "s_28171f9a": "இந்தப் பக்கத்தின் மாதிரிக்காட்சிகள் மற்றும் புள்ளிவிவரங்கள் பயனுள்ளதாக இருக்கும் முன் அதற்குத் தரவு தேவை.",
  "s_2852a855": "லேசான,",
  "s_2868fff4": "⌂ வீடு",
  "s_28747240": "(vs",
  "s_28a6f0c2": "சதி",
  "s_28adb028": "மருத்துவ அபாயக் குழு",
  "s_28b7a714": "காணாமல் போன ஹீட்மேப்",
  "s_28c3df69": "வகைப்படுத்தப்பட்ட வாடிக்கையாளர் திட்டங்கள்",
  "s_28fa9ceb": "தொடர்பு",
  "s_29000ba2": "- வரிசைகள்:",
  "s_29481bc1": "|　 எண் நெடுவரிசைகள்:",
  "s_296b4be7": "ஜி - சொல்லகராதிக்கு வெளியே",
  "s_29afe45c": "வரிசைகள்,",
  "s_29d2d595": "12 அம்சங்கள்; முதல் இரண்டு கேரி கிளாஸ் அமைப்பு மட்டுமே.",
  "s_29dd56d2": "குறைந்தபட்ச-அதிகபட்ச அளவு",
  "s_2a01c700": "மெகா எம்.எல்",
  "s_2a07407e": "CSV அல்லது JSON கோப்பைப் பதிவேற்ற கிளிக் செய்யவும்",
  "s_2a15a5a0": "பல்லுறுப்புக்கோவை மேற்பரப்பு",
  "s_2a37b398": "வரிசைகள்",
  "s_2a519c6e": "நடிகர்கள்",
  "s_2ab24e4b": "வணிகம்",
  "s_2aeeadf1": "ரயில் பிளவு",
  "s_2b1a4e72": "அல்காரிதத்தில் திறக்கவும்",
  "s_2b50db75": "மதிப்புகள் காணவில்லை.",
  "s_2b9abaed": "விரிவாக்கப்பட்ட பல்லுறுப்புக்கோவை அம்சங்கள்　ⓘ",
  "s_2c41499c": "வயது",
  "s_2ce09a5d": "சேமிக்கப்பட்ட தரவுத்தொகுப்புகள்",
  "s_2d69b051": "பொருந்தாத அம்ச அளவுகள்",
  "s_2de3076e": "அனைத்து செயல்பாடுகளும் திறக்கப்பட்டன",
  "s_2e007ff2": "கிளிப் மெட்டாடேட்டா மட்டும். ஆடியோ வகைப்பாடு உலாவியில் 440 ஹெர்ட்ஸ் / 880 ஹெர்ட்ஸ் / இரைச்சல் பிசிஎம் உருவாக்குகிறது.",
  "s_2e14a681": "பதிப்பு மீட்டமை",
  "s_2e9445f7": "குறைந்தபட்சம்",
  "s_2ec25cfe": "உரை உணர்வு தரவுத்தொகுப்பு (760 வரிசைகள்)",
  "s_2ee487a6": "குறியாக்கத்தைத் தேர்ந்தெடுக்கவும்",
  "s_2f3d7e8a": "▽ வடிகட்டி",
  "s_2fb366b1": "கட்டம்",
  "s_2ffae788": "ஒவ்வொரு நெடுவரிசையும் விடுபட்ட புள்ளிவிவரங்கள்",
  "s_304ff7fb": "இல்லை",
  "s_3171a39a": "மொத்த செயல்கள்",
  "s_3175ceb1": "கொடியேற்றப்பட்டது",
  "s_319de8c7": "தினசரி வெப்பநிலை, மழைப்பொழிவு, ஈரப்பதம் மற்றும் காற்று ஆகியவற்றை மென்மையாக்குவதற்கும் முன்னறிவிப்பதற்கும் விரிவாக்கப்பட்டது.",
  "s_321ff014": "பல்லுறுப்புக்கோவை இயந்திர வளைவு",
  "s_32737353": "■ லேசான",
  "s_32742df7": "முழுமையான செல்கள்",
  "s_32af6776": "↻　பார்வையை மீட்டமை",
  "s_32af9afb": "⬇''ஏன் அளவிட வேண்டும்?",
  "s_32b03356": "மேலும் பொருந்தக்கூடிய குறிப்பு(கள்).",
  "s_32d9a99c": "நெடுவரிசைகள்",
  "s_333b9aea": "முதலில் காட்டுகிறது",
  "s_33ca074b": "தரவுத்தொகுப்பு ஏற்றப்படவில்லை",
  "s_33ec1cd3": "பி — விளையாட்டு vs தொழில்நுட்பம்",
  "s_343e07a1": "திட்ட மேலோட்டம்",
  "s_3462eda9": "புறக்கணிக்கப்பட்ட நெடுவரிசைகளை கைவிடவும்",
  "s_347bdd30": "லேசான அவுட்லையர்கள்",
  "s_347e1194": "★ கடுமையான புறம்போக்கு",
  "s_353a4c49": "அதிர்வெண், அலைவீச்சு, ஹார்மோனிக் விகிதம் மற்றும் கால அளவு சைன், சதுரம், இரைச்சல் மற்றும் நாண் என லேபிளிடப்பட்டுள்ளது.",
  "s_353e0d45": "விருப்பங்கள்",
  "s_35408136": "ஆற்றல் திறன்",
  "s_359dd568": "வரிசைகளாக பல தனித்துவமான மதிப்புகளைக் கொண்டுள்ளது. குறியாக்கத்தைத் தவிர்த்து.",
  "s_35aeade3": "மறைக்கப்பட்ட வெயில்/மேகமூட்டம்/புயல் நிலைகளில் இருந்து தினசரி மழை அளவீடுகள் உருவாக்கப்படுகின்றன - ஒரு மறைக்கப்பட்ட மார்கோவ் மாதிரி வரிசை.",
  "s_35f80a93": "◯ தேர்ந்தெடுக்கப்பட்டது",
  "s_360fa296": "அவுட்லியர் பெருக்கி",
  "s_3624d499": "நேரத் தொடர்",
  "s_36bf90a7": "மாற்றத்தைப் பயன்படுத்தவும்",
  "s_36e7b096": "◎　வெளிப்புறங்கள்",
  "s_37082ee7": "பயனுள்ள + பொருத்தமற்ற அம்சங்கள்",
  "s_371ebe8c": "பாடம் முன்னேற்றம்",
  "s_37729448": "தேதி, போக்கு மற்றும் பருவத்துடன் விற்பனை",
  "s_377e865a": "நேரியல் அல்லாத உறவுகளைப் பிடிக்க பல்லுறுப்புக்கோவை சொற்களில் உள்ளீடுகளை விரிவாக்குங்கள்.",
  "s_3822e5a8": "தரவுத்தொகுப்பு பொருத்தம்",
  "s_382ee303": "வெளிப்புற சுருக்கம்",
  "s_386a277c": "● லேசான வெளிர்",
  "s_38bd9509": "கடன் ஒப்புதல் தரவுத்தொகுப்பு (760 வரிசைகள்)",
  "s_38fa761d": "போக்கு + பருவநிலை",
  "s_3906772a": "வாடிக்கையாளர் கர்ன் டேட்டாசெட் (760 வரிசைகள்)",
  "s_39101d0c": "பதிவேற்றம் CSV",
  "s_39347c05": "இதுவரை சேமிக்கப்பட்ட தரவுத்தொகுப்புகள் எதுவும் இல்லை. கோப்பைப் பதிவேற்றவும் அல்லது மாதிரிகளில் ஒன்றைச் சேமிக்கவும்.",
  "s_395d8933": "சேமிக்கப்பட்ட தரவுத்தொகுப்புகளைத் தேடுங்கள்",
  "s_399c8de7": "தரவுத்தொகுப்பு நுண்ணறிவு அடுக்கு",
  "s_39db4282": "● பூலியன்",
  "s_3a1425af": "ஏன் இந்த தரவுத்தொகுப்பு:",
  "s_3a1b6770": "தரநிலைப்படுத்தல் (Z-ஸ்கோர்)",
  "s_3a3a9204": "தரவுத்தொகுப்புகளைத் தேடு...",
  "s_3aee33e7": "இணக்கமான அல்காரிதம்கள்",
  "s_3b40d418": "செயற்கை குமிழ்கள்",
  "s_3bc5c262": "பொருத்தம் மற்றும் எளிமை ஆகியவற்றின் வலுவான சமநிலையை வழங்குகிறது.",
  "s_3ca154bf": "புள்ளி திருத்தி X அச்சு",
  "s_3ca7e3b9": "அதிகபட்சம்",
  "s_3d5073c9": "உணவு",
  "s_3d94d6a7": "காணவில்லை",
  "s_3e0d3ec9": "அளவிடுதல் மாதிரி செயல்திறன், நிலைத்தன்மை மற்றும் விளக்கத்தை மேம்படுத்துகிறது-குறிப்பாக தூரம் மற்றும் சாய்வு அடிப்படையிலான வழிமுறைகளுக்கு.",
  "s_3e142d5e": "உரை",
  "s_3e2cc80b": "· குறைந்தபட்சம்/அதிகபட்சம்:",
  "s_3eea7a3d": "· போக்கு:",
  "s_3eeb6b87": "கிள்ளுதல்",
  "s_3ef63340": "வாராந்திர சில்லறை தேவை வரிசை (760 வரிசைகள்)",
  "s_3f35643b": "அனைத்து வரிசைகளும் காட்டப்பட்டுள்ளன",
  "s_3f3b0f78": "டிராப் வரிசைகள் (ஏதேனும் விடுபட்டிருந்தால்)",
  "s_3ffd24a8": "♲　அவுட்லையர்களை அகற்று",
  "s_40052a16": "எண் அம்சம்",
  "s_4046b1c1": "குற்றச்சாட்டை ஒப்பிடுக",
  "s_409eeb15": "வகைகள்:",
  "s_4121b983": "ஐந்து திரைப்படங்களுக்கான விரிவாக்கப்பட்ட பயனர் உருப்படி மதிப்பீடுகள், கூட்டு வடிகட்டலுக்கான மதிப்பெண்கள் விடுபட்டது உட்பட.",
  "s_4144c46a": "② காட்சிப்படுத்தவும்",
  "s_415c6a16": "MA(1) செயல்முறை",
  "s_4190f551": "இலக்கு மாறிகள்",
  "s_41ef851c": "5 ஐக் காட்டுகிறது",
  "s_421b2773": "மீடியன் இம்ப்யூடேஷன் (எண்)",
  "s_42454824": "செய்ய",
  "s_425c7d78": "முழுமையற்ற வீட்டு பதிவுகள்",
  "s_425ed3ca": "மதிப்பு",
  "s_426579f4": "சமன்பாடு பில்டர்　ⓘ",
  "s_42db0023": "மாதிரி தரவுத்தொகுப்பு",
  "s_42f9875b": "⊙ உருமாற்றத்தைப் பயன்படுத்தவும் மற்றும் மறு மதிப்பீடு செய்யவும்",
  "s_4307c8a4": "வெளிப்புறக் கண்டறிதல்　ⓘ",
  "s_438f0c0c": "· Hapax:",
  "s_43b5a51e": "· விடுபட்ட காலங்கள்:",
  "s_441cdc70": "அம்சங்கள்:",
  "s_443b1e1a": "· சராசரி:",
  "s_444a0152": "முன் செயலாக்க படிகள்",
  "s_44c7f2ef": "திட்டம் மற்றும் பொருந்தக்கூடிய தன்மை",
  "s_4513f603": "விடுபட்ட நாட்கள் கொண்ட தொடர்",
  "s_454fa309": "இது எவ்வாறு வகைப்படுத்தப்படுகிறது",
  "s_46088539": "நெடுவரிசை(கள்)",
  "s_4670eaae": "எச் - மறுப்பு",
  "s_478503eb": "வழிகாட்டி",
  "s_479f37f3": "Z-ஸ்கோர் என்பது |x - சராசரி| / வகுப்பு. k க்கு மேல் உள்ள மதிப்புகள் லேசானவை; 2kக்கு மேல் மதிப்புகள் கடுமையானவை. தரவு வளைக்கப்படும் போது IQR ஐ விட இந்த முறை தீவிர வால்களுக்கு அதிக உணர்திறன் கொண்டது.",
  "s_47a0920b": "மதிப்பு மேட்ரிக்ஸ் இல்லை",
  "s_47e19ba9": "· நீளத் தொட்டிகள் (≤5 / ≤15 / ≤40 / ≤100 / 100+):",
  "s_47e2e15a": "உத்தி:",
  "s_4818aca0": "⊕　முக்கிய நுண்ணறிவு",
  "s_485d0345": "தற்போதைய தரவுத்தொகுப்பு புள்ளிவிவரங்களை புதிய மதிப்பிற்குப் பயன்படுத்தவும். இந்தச் சோதனை வரிசையைச் சேர்க்காது அல்லது குறிப்புப் புள்ளிவிவரங்களை மாற்றாது.",
  "s_4882a26b": "அவதானிப்புகள் கொடியிடப்பட்டுள்ளன",
  "s_48c8c430": "நேர்மறை, எதிர்மறை அல்லது நடுநிலை என்று பெயரிடப்பட்ட விரிவாக்கப்பட்ட தயாரிப்பு கருத்துகள்.",
  "s_48d59be0": "நிதி / வருவாய் தரவு",
  "s_494138b7": "ஜி - செறிவு வட்டங்கள்",
  "s_494e259f": "பிரதிகள்",
  "s_495403f2": "குறியாக்க கட்டுப்பாடுகள்",
  "s_49c97306": "மாடல் ஃபிட் ஒப்பீடு　ⓘ",
  "s_4a4ffecb": "அனைத்தையும் பார்க்கவும்",
  "s_4ab9818e": "முறை ஒப்பீடு திறக்கப்பட்டது",
  "s_4acadb26": "◆　பாலினோமியல் அம்சங்கள் நேரியலை அனுமதிக்கின்றன",
  "s_4b058728": "அமைப்புகள்",
  "s_4b0a7147": "மேலும் அம்சங்கள்",
  "s_4b1f0b98": "கே - சமநிலையற்ற வகுப்புகள்",
  "s_4b2cfbcc": "புறம்போக்கு",
  "s_4b3792d1": "தொடர் தயார்",
  "s_4bea2556": "நடுத்தர நெடுவரிசை நிலையானது. தரநிலைப்படுத்தல் NaN ஐ உருவாக்கக்கூடாது.",
  "s_4c3281b6": "தினசரி வானிலை முன்னறிவிப்பு தரவுத்தொகுப்பு (760 வரிசைகள்)",
  "s_4c49a720": "ஏற்றப்பட்டது",
  "s_4c5bf73d": "சேமிக்கப்பட்ட தரவுத்தொகுப்புகள்",
  "s_4c7302a5": "தரவுத்தொகுப்பு மூல URL",
  "s_4d6cd9e1": "இம்ப்யூடேஷன் விண்ணப்பிக்கவும்",
  "s_4e170796": "| நெடுவரிசைகள்:",
  "s_4e18469e": "மதிப்பு ஹீட்மேப் இல்லை",
  "s_4e222bf9": "· நெடுவரிசைகள்:",
  "s_4e3d73e0": "நேரியல் அல்லாத உறவுகளைக் கற்றுக்கொள்ள மாதிரிகள்.",
  "s_4e7b81f1": "உங்கள் முன்னேற்றம்",
  "s_4ebae2a4": "அம்ச வகைகள்",
  "s_4fa433e7": "நேரியல் பின்னடைவு மோசமாக பொருந்த வேண்டும்; பல்லுறுப்புக்கோவை பட்டம் 2 நன்கு பொருந்த வேண்டும்.",
  "s_4fc1e6ef": "செல்களைக் கண்டறியவும்",
  "s_4fc5c3a9": "ஆய்வு, சுரண்டல் மற்றும் வருத்தம் கண்காணிப்பு ஆகியவற்றிற்காக கை வெகுமதிகளை உருவாக்கியது.",
  "s_4fd3e96a": "டேட்டாசெட் லைப்ரரியில் இருந்து உருவாக்கப்பட்டது வெற்று திட்டம்.",
  "s_509e4f62": "`சிக்னல்` மட்டுமே y ஐ இயக்குகிறது. லாஸ்ஸோ / எலாஸ்டிக் நெட் இரைச்சல் நெடுவரிசைகளை சுருக்க வேண்டும்.",
  "s_50a6f234": "சம்பள அவுட்லியர் தணிக்கை",
  "s_50c5fcf7": "சிக்கலானது அதிகரிக்கும் போது செயல்திறன் மேம்படுகிறது (அதிக பொருத்தம் பார்க்கவும்).",
  "s_50fac474": "எஃப் - வார்த்தை உறவுகள்",
  "s_5147484e": "தரவுத்தொகுப்பு மேலாளர் மேல் மெனு",
  "s_514c620a": "நிலையான நிலை மாற்றம்",
  "s_531657ea": "மேற்பார்வை செய்யப்படாத / மேட்ரிக்ஸ் தரவு",
  "s_534e7732": "பயன்முறை",
  "s_5365be19": "வழக்குகளைப் பயன்படுத்தவும்",
  "s_5380c832": "இசட் மதிப்பெண்",
  "s_538a3534": "கசிவு ஆபத்து",
  "s_538b10e9": "திற",
  "s_53ad2637": "இரண்டு கச்சிதமான கிளாஸ் மேகங்களை ஒரு ஹைப்பர் பிளேன் பிரிக்கலாம் - பெர்செப்ட்ரான் மற்றும் லாஜிஸ்டிக் ரிக்ரஷன் சொந்த ஊர்.",
  "s_53e8655b": "⌕ நெடுவரிசைகளைத் தேடு...",
  "s_53ff6f74": "மாதாந்திர விற்பனை போன்றது",
  "s_5405f600": "நேர நெடுவரிசை: தேதி · இலக்கு: மதிப்பு · அதிர்வெண்:",
  "s_542bcc94": "மூலம்",
  "s_542e3d15": "· தனிப்பட்ட டோக்கன்கள்:",
  "s_54507d5e": "கர்ன் கணிப்பு",
  "s_546934e4": "✓ முறைகளை ஒப்பிடுக (IQR vs Z-ஸ்கோர்)",
  "s_54867daf": "தொழில்நுட்பம்",
  "s_d0c27b03": "தரவுத்தொகுப்பு",
  "s_d57a0a54": "ஒப்பிடு",
  "s_dc452030": "தரவுத்தொகுப்புகள்"
}
