{
  "s_008c3136": "நேரடி கேமரா",
  "s_0736dd56": "திணிப்பு",
  "s_0a54e38c": "உலாவி அனுமானம்",
  "s_0ac8a560": "மீட்டமை",
  "s_115bfcb9": "வசன வரிகள்",
  "s_125342c6": "கேமராவைத் தொடங்கவும்",
  "s_173fd9c6": "படக் கோப்பை ஏற்றவும்",
  "s_177ad6f4": "பொருள் 2",
  "s_17897598": "வாசல்",
  "s_17ec53cb": "படங்கள்",
  "s_186c57b2": "உண்மையான \\ முந்தைய",
  "s_18a7beee": "காலி",
  "s_18e00785": "சட்டத்தை சேமிக்கவும்",
  "s_19878e5f": "TFjs மாதிரியை ஏற்றவும்",
  "s_1a7adbad": "பொருள் 1",
  "s_1c1bbf3c": "போஸ் வகைப்படுத்தி பயிற்சி பெற்றவர். கணிப்புகள் இப்போது எலும்புக்கூடு மேலடுக்கில் தோன்றும்.",
  "s_1f5a27d0": "நேரடி கேமரா மற்றும் அனுமானம்",
  "s_1f5fa991": "நம்பிக்கை:",
  "s_2058e496": "உதாரணங்கள்",
  "s_20d29dae": "போஸ் கண்டறிதல் மற்றும் வகைப்பாடு",
  "s_21f563dc": ": அண்டை நாடுகளுடன் ஒப்பிடும்போது மையப் பிக்சலைப் பெருக்குகிறது - விளிம்புகளை மேம்படுத்துகிறது.",
  "s_22754373": "தொகுதி:",
  "s_23c85bd0": "கணினி பார்வை",
  "s_25139dbf": "அனுமானத்தை இயக்கும் முன் டிடெக்டரைப் பயிற்றுவிக்கவும்.",
  "s_255328d1": "TensorFlow.js உலாவி பயிற்சி",
  "s_273ff298": "பயிற்சி குழப்ப மேட்ரிக்ஸ்",
  "s_28b2fac8": ": தீவிர சாய்வுகளைக் கணக்கிடுவதன் மூலம் கிடைமட்ட அல்லது செங்குத்து விளிம்புகளைக் கண்டறியவும்.",
  "s_291f70f4": "மேல் நம்பிக்கை",
  "s_297fac3f": "இதுவரை சேமிக்கப்பட்ட பிரேம்கள் இல்லை.",
  "s_2bd9cf37": "முஷ்டி",
  "s_2c4cb102": "கேமரா நிறுத்தப்பட்டது. இறக்குமதி செய்யப்பட்ட படங்கள், லேபிள்கள் மற்றும் பயிற்சியளிக்கப்பட்ட மாதிரி ஆகியவை கிடைக்கின்றன.",
  "s_30b6b1f0": "கேமராவை நிறுத்து",
  "s_31e42c2e": "சேமிக்கப்பட்ட சட்டங்கள்",
  "s_33e95771": ": சராசரி அண்டை பிக்சல்கள் - சத்தத்தை மென்மையாக்குகிறது.",
  "s_33f20673": "இயக்க நேர நிலை",
  "s_34267710": "வெளியீட்டு அம்ச வரைபடம் (",
  "s_349674d2": "வகுப்பு லேபிள்கள்",
  "s_3537c046": "சரிபார்த்தல் பிளவு",
  "s_3689fefe": "அடுத்ததாக நகலெடுக்கவும்",
  "s_3bd13dc4": "ஒரு வட்டமிடவும்",
  "s_3dcb773e": "நேரடி அளவீடுகள்",
  "s_3e7a725d": "பொதுவான வடிப்பான்கள் விளக்கப்பட்டுள்ளன",
  "s_4186ee86": ": படத்தை மாறாமல் கடந்து செல்கிறது.",
  "s_42e40961": "வெற்று",
  "s_43727f24": "வகுப்பைச் சேர்க்கவும்",
  "s_4458c64e": "தெளிவின்மை (சராசரி 3×3)",
  "s_46fc003a": "உள்ளூர் தரவுத்தொகுப்புகள், கட்டுப்பாடுகள், காட்சிப்படுத்தல்கள், அளவீடுகள் மற்றும் ஏற்றுமதிகளுடன் ஊடாடும் உலாவி-மட்டும் KMeans படப் பிரிவு தொகுதி.",
  "s_47012e6c": "தானாக பெருக்குதல்",
  "s_474e6a1d": "முன்னமைக்கப்பட்ட பட வடிவத்தைத் தேர்வுசெய்க:",
  "s_4a0206ff": "பட கோப்புறையை இறக்குமதி செய்யவும்",
  "s_4b7a788b": "இருப்பு",
  "s_4b7f7705": "நிறுத்து",
  "s_4c0591d5": "தோரணைகள்",
  "s_4f674dec": "மாதிரியை ஏற்றுமதி செய்வதற்கு முன் வகைப்படுத்தியைப் பயிற்றுவிக்கவும்.",
  "s_5126f84c": "5-ஆங்கர் டிடெக்டர்",
  "s_514c943e": "BodyPix பிரிவை ஏற்றுகிறது...",
  "s_514c98f2": "பெட்டிகள்",
  "s_54392fcb": "விளக்கம்",
  "s_5457d6e6": "பிந்தைய செயலாக்கம்",
  "s_573c1182": "பதிவு செய்ய பிடி",
  "s_58d93e78": "மேலடுக்கு ஒளிபுகாநிலை:",
  "s_5973596b": "உள்ளீடு (",
  "s_5bed43eb": "உள்ளீடு அகலம்",
  "s_5d57f2b2": "பின்னணி தெளிவின்மை",
  "s_5d61fbff": "சைகை வகைப்படுத்தி பயிற்சியளிக்கப்பட்டது. நேரடி அனுமானத்திற்கு உங்கள் கையைக் காட்டுங்கள்.",
  "s_5e68a791": "சைகை அளவீடுகள்",
  "s_5e7c2199": "டிடெக்டர் ஏற்றுமதி செய்யப்பட்டது. மாதிரி கோப்புகள் மற்றும் லேபிள்களை JSON ஒன்றாக வைக்கவும்.",
  "s_5f8fe74f": "ஹீட்மேப் மேலடுக்கு",
  "s_63466a40": "வெப்கேமை தொடங்கவும்",
  "s_63ba46bc": "செக்கர்",
  "s_63ba6e7f": "கணிப்பு மதிப்பெண்கள்",
  "s_63bf834d": "வகுப்பு 2",
  "s_63f830de": "சோபல் எக்ஸ்/ஒய்",
  "s_64c46678": "30 லைவ் வெப்கேம் பிரேம்களில் இருந்து நம்பிக்கை வரம்பை அளவீடு செய்கிறது...",
  "s_655ae915": "தரவுத்தொகுப்பு சமநிலையானது. பயிற்சிக்கு தயார்.",
  "s_6c44a12a": "நம்பிக்கை வாயில்:",
  "s_6f8737b6": "எடுத்துக்காட்டுகள்",
  "s_70bfd099": "முன்னமைவுகள் & உள்ளீடு",
  "s_71cfacc1": "நேரடி போஸ் கணிப்பு",
  "s_72d864e5": "பயிற்சியின் போது இழப்பு தோன்றும்.",
  "s_745134ce": "இருப்பு முறை",
  "s_7460e1a0": "வெளியீடு செல்",
  "s_7469274c": "உள்ளீடு[i·s + m][j·s + n] × கர்னல்[m][n]",
  "s_75a0a146": "வெப்கேமை நிறுத்து",
  "s_76b38122": "பயிற்சி முடிந்தது. வெப்கேமில் இருந்து நேரடி அனுமானம் இயங்குகிறது.",
  "s_79281b90": "நேரடி வெப்கேம்",
  "s_7a9fc840": "நிராகரிப்பு விகிதம்:",
  "s_7c2e49cc": "வடிகட்டி தேர்வி",
  "s_7e687754": "NMS IoU:",
  "s_7f503057": "வரம்பு [",
  "s_80bb4533": "ஏற்றுமதி தற்போதைய நிலை JSON"
}
