{
  "s_01ad635b": "FPR",
  "s_05bdc074": "சராசரி",
  "s_0914231b": "விடுபட்ட மதிப்புகள்",
  "s_09a28b96": "அதிகப்படியான பொருத்தம்",
  "s_0ac8a560": "மீட்டமை",
  "s_0b3aa6ec": "வடிப்பான்கள்",
  "s_1359624c": "○ சவால்கள்",
  "s_137753f4": "தரவுத்தொகுப்பைப் பதிவேற்றவும்",
  "s_1461ae69": "இனங்கள் (",
  "s_147ac7b9": "⌘ காட்சியைச் சேமி",
  "s_149844a3": "வெளிப்புற விதி",
  "s_1646f650": "மெட்ரிக் சூத்திரங்கள்",
  "s_1659ed66": "ⓘ குறைந்த ஆதரவு வகுப்பிற்கான கூடுதல் மாதிரிகளைக் கவனியுங்கள்.",
  "s_172421f5": "⚙ அமைப்புகள் ↤",
  "s_175fee47": "சராசரி சதுரப் பிழை",
  "s_17897598": "வாசல்",
  "s_178ab477": "○ சவால்",
  "s_18632b8a": "பூட்டு விகிதங்கள்",
  "s_19cc8b52": "ஐசோ-எஃப்1 வரிகளைக் காட்டு",
  "s_1a2d78a6": "● நேர்மறை (உண்மை)",
  "s_1a36a166": "முன்னேற்றம்",
  "s_1bbc554c": "விளையாட்டு மைதானம்",
  "s_1c8183e5": "- பயிற்சி பிழை",
  "s_1cb7310b": "காட்சி விருப்பங்கள்",
  "s_1cf8b937": "சார்பு-மாறுபாடு வர்த்தகம்",
  "s_1e127109": "பயிற்சியளி",
  "s_1eab94af": "பெறப்பட்ட அளவீடுகள்",
  "s_1ef2e3d3": "தரவுத்தொகுப்பு ⓘ",
  "s_1f0f7d92": "உண்மை vs கணிக்கப்பட்டது",
  "s_1f634a60": "(தற்போதைய சிக்கலான நிலையில்) ⓘ",
  "s_1ff1ed6f": "சிதறிய தரவுகள் மற்றும் எல்லைகளில் உள்ள பகுதிகளில் நிச்சயமற்ற தன்மை அதிகமாக உள்ளது.",
  "s_20431b75": "கற்றுக்கொள்ளுங்கள்",
  "s_205b46ae": "பூஜ்ஜிய பிழை வரியைக் காட்டு",
  "s_21047c47": "சரிபார்ப்பு சதவீதம்",
  "s_21212fe1": "துல்லியமான நினைவுப் பிரிவுகள்",
  "s_218f1983": "☆ அதிக தவறான நேர்மறைகள் (குறைந்த துல்லியம்) செலவில் அதிக நேர்மறைகளை (அதிக நினைவுகூருதல்) கைப்பற்ற வாசலைக் குறைக்கவும். எதிர் வர்த்தகத்திற்கு அதை அதிகரிக்கவும்.",
  "s_22951eaa": "பிழைகள் எப்போது மிகவும் முக்கியமானவை?",
  "s_22a4deb2": "மோசடி கண்டறிதல்",
  "s_22a71ea1": "சீரற்ற அடிப்படை",
  "s_22f56577": "TN",
  "s_23370b3c": "MSE",
  "s_23ad867f": "⚠ பார்வைக்கு ஒத்த வகுப்புகளுக்கு இடையே பெரும்பாலான குழப்பம் ஏற்படுகிறது. மிகப்பெரிய ஆஃப்-மூலைவிட்ட கலத்தை மதிப்பாய்வு செய்யவும்.",
  "s_23b08c6d": "ROC வளைவு & AUC",
  "s_23eb1519": "‹ விளையாட்டு மைதானம்",
  "s_23f06ca7": "தரவு விஞ்ஞானி",
  "s_242b2a9e": "திறப்பது கையேடு TP/TN/FP/FN, கடன் வரம்பு, சூத்திரங்கள் மற்றும் நகல் கருவிகளைப் பாதுகாக்கிறது.",
  "s_24b13d10": "PR AUC சுருக்கம்",
  "s_25dd318a": "வகுப்புகள்)",
  "s_2627c791": "புறம்போக்குகள் பிழைகளை அதிகரிக்கின்றன. MSE மற்றும் RMSE ஆகியவை MAE விட வெளியாட்களுக்கு அதிக உணர்திறன் கொண்டவை. வெளிப்புறங்கள் அகற்றப்படும்போது R² மேம்படும்.",
  "s_26562998": "அனைத்து மாதிரிகளையும் காண்க",
  "s_26b4d6f3": "மேம்பட்ட விருப்பங்கள் ›",
  "s_26cf13bf": "ஊடாடும் பயாஸ்-வேரியன்ஸ் எக்ஸ்ப்ளோரர்",
  "s_272a2714": "— துல்லியம் மட்டுமே தவறாக வழிநடத்தும் சமநிலையற்ற தரவுத்தொகுப்புகள்",
  "s_27d37f32": "%), 50% அல்ல.",
  "s_27fa1127": "● வெளியாட்கள்",
  "s_2817e4e3": "சுயவிவரம் திறக்கப்பட்டது",
  "s_285691ac": "லாஜிஸ்டிக் பின்னடைவு",
  "s_2868fff4": "⌂ வீடு",
  "s_28ea5410": "வலுவான நினைவூட்டல் உள்ளது.",
  "s_28f56ee9": "TP",
  "s_29551803": "நேர்மறை வகுப்பு தேர்ந்தெடுக்கப்பட்டது",
  "s_29e14a66": "ரிட்ஜ் பல்லுறுப்புக்கோவை",
  "s_2a01c700": "மெகா எம்.எல்",
  "s_2a37b398": "வரிசைகள்",
  "s_2b781882": "● எதிர்மறை (உண்மை)",
  "s_2c856198": "பயன்முறை:",
  "s_2cda1cd4": "உண்மையான மற்றும் கணிக்கப்பட்ட சிதறல் சதி",
  "s_2d234c50": "வாசல் ⓘ",
  "s_2e64a848": "வழிகாட்டிகள்",
  "s_2e90637c": "ROC வளைவு ⓘ",
  "s_2eb1de26": "சமப்படுத்தப்பட்ட F1",
  "s_2eb24154": "கணிப்பு பரவல் (நிச்சயமற்ற தன்மை) ⓘ",
  "s_2f9df15c": "தற்போதைய வரம்பு அளவீடுகள்",
  "s_2ffcbe05": "சோதனை",
  "s_304ff7fb": "இல்லை",
  "s_313816a0": "வகைப்படுத்தி வகுப்புகளை வலுவாக பிரிக்கிறது. மருத்துவ நோயறிதல் அல்லது மோசடி கண்டறிதல் போன்ற உயர்-பங்கு முடிவுகளுக்கு ஏற்றது.",
  "s_32e1ec25": "(அனைத்து வகுப்புகளும்)",
  "s_3390849a": "கற்றல் முன்னேற்றம்",
  "s_339b2d92": "இதய நோய் - கிளீவ்லேண்ட்",
  "s_33e04997": "கடன் தரவுத்தொகுப்பு",
  "s_35408136": "ஆற்றல் திறன்",
  "s_355d5061": "TPR",
  "s_35eb9f18": "வளைவில் உள்ள ஒவ்வொரு புள்ளியும் ஒரு குறிப்பிட்ட வாசலில் கணக்கிடப்படுகிறது. வாசலை நகர்த்துவது துல்லியம் மற்றும் நினைவுகூருதலை மாற்றுகிறது.",
  "s_36079a5b": "வாசலில்",
  "s_370fe4ce": "▧ சார்பு-மாறுபாடு வர்த்தகம்",
  "s_371ebe8c": "பாடம் முன்னேற்றம்",
  "s_3730874d": "? உதவி",
  "s_3759bcfa": "MAE",
  "s_3871138e": "பட்டங்கள்",
  "s_387c7493": "- உண்மை-எதிர்மறை விகிதம் முக்கியமான ஸ்கிரீனிங் சோதனைகள்",
  "s_38eda60e": "பிழை அளவீடுகள் மற்றும் காட்சி கண்டறிதல்களைப் பயன்படுத்தி செயல்திறனைப் புரிந்து கொள்ளுங்கள். அவுட்லையர்கள் உங்கள் மாதிரியை எவ்வாறு பாதிக்கின்றன என்பதை ஆராயுங்கள்.",
  "s_39101d0c": "பதிவேற்றம் CSV",
  "s_39dd2869": "வகைப்படுத்திக்கு பாரபட்சமான திறன் இல்லை. அதன் ROC வளைவு மூலைவிட்டத்தைப் பின்பற்றுகிறது. அம்சங்கள் மற்றும் மாதிரியை மறுபரிசீலனை செய்யவும்.",
  "s_3a082297": "தவறான எதிர்மறை விகிதம்",
  "s_3a32f6bc": "பகிர்வு இணைப்பு நகலெடுக்கப்பட்டது",
  "s_3a943308": "● சுழற்சி",
  "s_3ad53794": "AP",
  "s_3beda13c": "சரிபார்ப்பு மதிப்பெண்",
  "s_3c0d9ed9": "தரவுத்தொகுப்பை மாற்றவும்",
  "s_3c66258e": "மாதிரிகளை ஒப்பிடுக",
  "s_3d12df9a": "சரிபார்த்தல்",
  "s_3dcb773e": "நேரடி அளவீடுகள்",
  "s_3dd53c4d": "AS",
  "s_3f08ac17": "ROC & AUC · 3 / 4",
  "s_3f145135": "பொதுமைப்படுத்தல் இடைவெளி",
  "s_3f325987": "சிறந்த சார்பு-மாறுபாடு சமநிலையை வழங்குகிறது.",
  "s_3f9e6640": "▣ அடுத்து என்ன?",
  "s_3fdfcccf": "எம்.எம்",
  "s_40be3f26": "PR வளைவை எப்போது படிக்க வேண்டும்",
  "s_41791b39": "அறிக › அடிப்படை கருத்துகள் ›",
  "s_41ea6551": "மென்மையான தொட்டிகள்",
  "s_42db0023": "மாதிரி தரவுத்தொகுப்பு",
  "s_4498bb49": "அனிமேஷன் இடைநிறுத்தப்பட்டது",
  "s_44c166c9": "பயிற்சி மற்றும் சரிபார்ப்பு பிழை வளைவுகள்",
  "s_4562c24b": "மதிப்பெண் விநியோக வரைபடம்",
  "s_456d146b": "பின்னடைவு அளவீடுகள் பிரிவுகள்",
  "s_4597f414": "குழப்ப மேட்ரிக்ஸ் மதிப்புகளை உள்ளிடவும்",
  "s_45efac3d": "ரூட் சராசரி ஸ்கொயர் பிழை",
  "s_46a6d99f": "சீரற்ற விதை",
  "s_46b767f3": "காட்சி சேமிக்கப்பட்டது",
  "s_4784d53c": "⇧ பதிவேற்றங்கள்",
  "s_478d76fc": "தரவுத்தொகுப்பு ஏற்றப்பட்டது",
  "s_47d5dc66": "● ஸ்வீட் ஸ்பாட்",
  "s_481bae8b": "கடன் தரவுத்தொகுப்பு — வரம்பு அடிப்படையிலான வகைப்படுத்தி",
  "s_48287160": "மடிப்பு சுழற்சியை அனிமேஷன் செய்கிறது",
  "s_4880662c": "சிறியது",
  "s_491bdb50": "அனைத்து வகுப்புகளும்",
  "s_493f5cf5": "கட்டுப்பாட்டு வரம்பு",
  "s_49fe6e98": "உயர் வகுப்பு ஏற்றத்தாழ்வு துல்லியத்தை தவறாக வழிநடத்துகிறது. துல்லிய-ரீகால் வளைவு சரியான கருவி.",
  "s_4acf670d": "வரம்பு பரிந்துரைகள்",
  "s_4adde30c": "இயல்பாக்குங்கள்",
  "s_4b2cfbcc": "புறம்போக்கு",
  "s_4bfcd2ed": "நேர்மறைகள் அரிதாக இருக்கும் போது ROC ஐ விட துல்லியமான-நினைவூட்டல் பெரும்பாலும் அதிக தகவல் தரும், ஏனெனில் தவறான நேர்மறைகள் துல்லியத்தை வலுவாக பாதிக்கிறது.",
  "s_4c18a4cb": "ஸ்ப்லைன் தோராயம்",
  "s_4c31e75e": "சம அச்சு அளவுகோல்",
  "s_4ca3662e": "நேர்மறை வகுப்பு",
  "s_4d2f830b": "மாடல் சிக்கலானது பொருத்தமற்ற மற்றும் அதிகப்படியான பொருத்தத்தை எவ்வாறு பாதிக்கிறது என்பதை ஆராயுங்கள்.",
  "s_4d4cc208": "சரி)",
  "s_4e434454": "கசிவு மதிப்பாய்வு திறக்கப்பட்டது",
  "s_4f4fd0ff": "% உண்மை",
  "s_4f56ac2c": "எச்சங்கள் மற்றும் கணிக்கப்பட்ட சிதறல் சதி",
  "s_501b0925": "உண்மை",
  "s_504539ee": "உண்மையான + ↑ | உண்மையான − ↓",
  "s_5157b1d8": "3-வகுப்பு குழப்ப மேட்ரிக்ஸ்",
  "s_515ef35a": "CSV உண்மையான மற்றும் கணிக்கப்பட்ட நெடுவரிசைகள் தேவை",
  "s_52d64750": "அடுத்த மாதிரியை ஒப்பிடலாம்",
  "s_534352fb": "கணக்கிடப்பட்ட அளவீடுகள்",
  "s_540e5d2d": "உண்மை:",
  "s_5438bb1b": "மடிப்புகள்",
  "s_5457d1e6": "அனிமேஷன் மீட்டமைப்பு",
  "s_545e66f2": "மொத்த நெடுவரிசைகள்",
  "s_547594ff": "படிப்பு விலகல்",
  "s_55220fd0": "⇧ ஏற்றுமதி",
  "s_56230870": "▷ அனிமேஷன்",
  "s_5806d5b4": "⟳ பெரிதாக்கு மீட்டமை",
  "s_58791cab": "ஒட்டுமொத்த துல்லியம்:",
  "s_58bbdb13": "விநியோக சோதனை",
  "s_59b763de": "• நெடுவரிசை 'பெயர்' இலக்கு கசிவைக் கொண்டிருக்கலாம்.",
  "s_5b4ef0d9": "மதிப்பெண் விநியோகம்",
  "s_5bb31d33": "2 சிக்கல்கள் கண்டறியப்பட்டன",
  "s_5c8537a2": "வெவ்வேறு அல்காரிதம்கள் புறம்போக்குகளை எவ்வாறு கையாளுகின்றன என்பதை ஆராயுங்கள்.",
  "s_5d34b29c": "⇧ அனைத்து பாடங்களும்",
  "s_5d84c4f7": "துல்லியம் vs ரீகால்",
  "s_5ddc62eb": "எல்லா அளவீடுகளும் ஒவ்வொரு ஸ்லைடர் மாற்றத்திலும் உண்மையான மற்றும் கணிக்கப்பட்ட வரிசைகளிலிருந்து மீண்டும் கணக்கிடப்படுகின்றன; எச்சங்கள் உண்மையான கழித்தல் கணிக்கப்பட்டவை.",
  "s_5f87029b": "கணிக்கப்பட்டது",
  "s_5f945f85": "பின்னடைவு அளவீடுகள்",
  "s_6151580b": "ஒரு மடங்கு மதிப்பெண்கள் ⓘ",
  "s_6161cb62": "AUC விளக்க வழிகாட்டி",
  "s_6173237b": "● எதிர்மறை (நோய் இல்லை)",
  "s_617cfa11": "உள்ள மாறுபாட்டின்",
  "s_61b05311": "சத்தம்:",
  "s_62b82bdf": "முந்தைய %",
  "s_64382a3e": "↻ வாசலை மீட்டமைக்கவும்",
  "s_64ca5c4d": "K-1 மடிப்புகளில் பயிற்சியளிப்பதன் மூலமும், மீதமுள்ள மடிப்பில் சரிபார்ப்பதன் மூலமும் மாதிரி செயல்திறனை மதிப்பிடுங்கள்.",
  "s_65a99167": "நகல் வரிசைகள்",
  "s_66e1597a": "பட்டம் (பலினோமியல்)",
  "s_67a90986": "டேட்டாவில் மாடல் ஃபிட் ⓘ",
  "s_6871d780": "உண்மை நேர்மறை",
  "s_68acb377": "(இணைக்கப்பட்ட மாதிரிகளைப் பார்க்கவும்)",
  "s_69836e1e": "பின்னடைவு ›",
  "s_6aadb3ce": "விகிதங்கள் புதுப்பிக்கப்பட்டன",
  "s_6b3f6234": "மார்பக புற்றுநோய்",
  "s_6b4b0d19": "வரம்பு மதிப்பு",
  "s_6b68c43e": "மாதிரி சிக்கலானது",
  "s_d0c27b03": "தரவுத்தொகுப்பு"
}
