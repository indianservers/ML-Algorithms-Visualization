{
  "s_045cee61": "ಸ್ಥಳೀಯ ಮಿನಿಮಾ ಮತ್ತು ಸ್ಯಾಡಲ್ ಪಾಯಿಂಟ್‌ಗಳು",
  "s_067820e5": "ಮ್ಯಾಟ್ರಿಕ್ಸ್ ಫ್ಯಾಕ್ಟರೈಸೇಶನ್",
  "s_0736dd56": "ಪ್ಯಾಡಿಂಗ್",
  "s_07903f93": "ಹಾಲ್ಟ್-ವಿಂಟರ್ಸ್",
  "s_08c14359": "ಗಮನ",
  "s_0a54e38c": "ಬ್ರೌಸರ್ ನಿರ್ಣಯ",
  "s_0e3625ae": "ನ್ಯೂರಾನ್ ಮತ್ತು ಪರ್ಸೆಪ್ಟ್ರಾನ್",
  "s_0efb196c": "ಪದ ಎಂಬೆಡಿಂಗ್",
  "s_14c3c48e": "ಡೇಟಾಸೆಟ್ ಇಂಟೆಲಿಜೆನ್ಸ್",
  "s_14dabb65": "ನಿಮ್ಮ ಮಾದರಿಗೆ ತರಬೇತಿ ನೀಡಿ",
  "s_1a481506": "ಪಠ್ಯ ವರ್ಗೀಕರಣ",
  "s_2535db63": "ಮಾದರಿ ಹೋಲಿಕೆ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್",
  "s_52f50eae": "ಮುಖಪುಟ"
}
